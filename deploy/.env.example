SPOOLSIDE_ORIGIN=https://spoolside.shelbyklein.com
# salt:scrypt hash; generate credentials locally and transfer privately
SPOOLSIDE_PIN_HASH=

# Exact Docker network gateway observed for this project; trust no arbitrary proxy.
SPOOLSIDE_PROXY_ADDRESS=

# Turns on print-watch vision checks (Claude). Leave empty to only save photos and ask outcomes.
ANTHROPIC_API_KEY=

# Turns on the Claude chat panel, on your Claude subscription. Create with `claude setup-token`.
# The chat never uses ANTHROPIC_API_KEY, so chats don't bill the API.
CLAUDE_CODE_OAUTH_TOKEN=
